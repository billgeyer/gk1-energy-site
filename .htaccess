# Force browsers to revalidate HTML/vCard content on every visit instead of
# silently reusing a stale cached copy after a deploy (this bit Bill on
# Android Chrome: it kept showing the pre-update lead-form confirmation
# text for a page it had visited before, even after a fresh upload).
# "no-cache" per the HTTP spec means "always ask the server first," not
# "never cache" — the server can still answer with a cheap 304 if nothing
# changed, so this doesn't cost real bandwidth.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|vcf)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Images change rarely, so let browsers cache them longer. If an image is
  # ever swapped in place (same filename, new content), rename the file or
  # add a version suffix rather than relying on this cache to clear itself.
  <FilesMatch "\.(jpg|jpeg|png|svg|gif|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
